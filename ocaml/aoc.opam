opam-version: "2.0"
synopsis: "Advent of Code solutions in OCaml"
maintainer: "jwa"
authors: "jwa"
license: "Unlicense"

# Pinned exactly, so the toolchain a solution was written against is recorded
# rather than inferred. ocamlformat and ocaml-lsp-server are deliberately
# absent: they are editor-side tools, they do not affect what the code compiles
# to, and they are allowed to track their latest releases.
depends: [
  "ocaml" {= "5.4.1"}
  "dune" {= "3.24.2"}
]

build: [["dune" "build" "-p" name "-j" jobs]]
